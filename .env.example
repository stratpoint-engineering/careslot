# CareSlot environment variables. Copy to .env for local use; never commit real values.
# Deployed environments get these from the ECS task definition / AWS Secrets Manager.

# Which settings file: config.settings.dev (local), config.settings.test, config.settings.prod (staging + production)
DJANGO_SETTINGS_MODULE=config.settings.dev

# Required in prod. A long random string (e.g. `python -c "import secrets; print(secrets.token_urlsafe(50))"`).
DJANGO_SECRET_KEY=

# Comma-separated. Required in prod (the site's host names).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated https origins. Required in prod (e.g. https://book.example.com).
DJANGO_CSRF_TRUSTED_ORIGINS=

# PostgreSQL URL. Required in prod (RDS). Leave empty locally to use SQLite (db.sqlite3).
# Local Postgres from docker-compose: postgres://careslot:careslot@localhost:5432/careslot
DATABASE_URL=
# Seconds to keep a DB connection open in dev (prod uses the psycopg pool instead).
DB_CONN_MAX_AGE=60

# Clinic time zone, e.g. Asia/Manila. Required in prod. OPEN QUESTION (ARCH-CARESLOT-v1 §9 Q2): confirm the value.
CLINIC_TIME_ZONE=UTC

# Sender of the reminder email (Day 1, Amazon SES).
DEFAULT_FROM_EMAIL=CareSlot <no-reply@careslot.invalid>

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Day 1 (documented now, not read by Day 0 code) ---
# Celery broker for the reminder outbox job (ElastiCache Redis).
REDIS_URL=
# AWS region for SES and the rest of the stack. OPEN QUESTION (ARCH-CARESLOT-v1 §9 Q1): must satisfy BR-013.
AWS_REGION=
